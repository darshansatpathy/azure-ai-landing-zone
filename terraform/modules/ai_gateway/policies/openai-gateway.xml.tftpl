<policies>
  <inbound>
    <base />
    <!-- Only callers holding a valid Microsoft Entra token for this audience get through. -->
    <validate-jwt header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized" require-expiration-time="true" require-scheme="Bearer" require-signed-tokens="true">
      <openid-config url="https://login.microsoftonline.com/${tenant_id}/v2.0/.well-known/openid-configuration" />
      <audiences>
        <audience>${audience}</audience>
      </audiences>
      <issuers>
        <issuer>https://sts.windows.net/${tenant_id}/</issuer>
      </issuers>
    </validate-jwt>
    <!-- One token budget per calling identity, so a single noisy caller cannot exhaust the quota. -->
    <llm-token-limit counter-key="@(context.Request.Headers.GetValueOrDefault("Authorization","").AsJwt()?.Subject ?? "anonymous")" tokens-per-minute="${tokens_per_minute}" estimate-prompt-tokens="true" remaining-tokens-header-name="x-remaining-tokens" />
    <llm-emit-token-metric namespace="ai-gateway">
      <dimension name="API ID" />
      <dimension name="Operation ID" />
    </llm-emit-token-metric>
    <!-- The gateway authenticates to the model with its own managed identity. No key exists. -->
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" client-id="${gateway_client_id}" output-token-variable-name="msi-access-token" ignore-error="false" />
    <set-header name="Authorization" exists-action="override">
      <value>@("Bearer " + (string)context.Variables["msi-access-token"])</value>
    </set-header>
    <set-header name="x-ms-client-request-id" exists-action="skip">
      <value>@(context.RequestId.ToString())</value>
    </set-header>
  </inbound>
  <backend>
    <retry condition="@(context.Response.StatusCode == 429 || context.Response.StatusCode >= 500)" count="2" interval="1" max-interval="8" delta="1" first-fast-retry="true">
      <forward-request buffer-request-body="true" />
    </retry>
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
